# Include this file from the nginx http context.
# Replace example hostname, TLS paths and allocation address before enabling.
map $http_upgrade $vector_connection_upgrade {
    default upgrade;
    '' close;
}
upstream vector_app {
    server 127.0.0.1:3000;
    keepalive 16;
}
server {
    listen 80;
    server_name vector.example.com;
    return 301 https://vector.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name vector.example.com;
    ssl_certificate /etc/letsencrypt/live/vector.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vector.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 128k;

    # Defense in depth: private files must never be served by the proxy.
    location ~ /\. { return 404; }
    location ~ ^/(?:src|scripts|data|logs|node_modules|design|deploy|tests)(?:/|$) { return 404; }
    location / {
        proxy_pass http://vector_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vector_connection_upgrade;
        proxy_read_timeout 75s;
        proxy_send_timeout 30s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
        proxy_hide_header X-Powered-By;
    }
}
