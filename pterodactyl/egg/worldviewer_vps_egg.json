  "description": "Custom egg for WorldViewer feed + optional frontend preview on VPS Egg base.",
  "docker_images": {
    "Quay.io": "quay.io/ydrag0n/pterodactyl-vps-egg:latest"
  },
  "file_denylist": [],
  "startup": "./run.sh",
  "config": {
    "files": "{}",
    "startup": "{\"done\":\"Starting\"}",
    "logs": "{}",
    "stop": "exit"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\nset -e\ncd /mnt/server\nchmod +x pterodactyl/scripts/install.sh pterodactyl/scripts/run.sh\n./pterodactyl/scripts/install.sh\ncp -f pterodactyl/scripts/run.sh /mnt/server/run.sh\nchmod +x /mnt/server/run.sh",
      "container": "quay.io/ydrag0n/pterodactyl-vps-egg",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {"name":"Repository URL","description":"Git repository containing this project","env_variable":"REPO_URL","default_value":"","user_viewable":true,"user_editable":true,"rules":"required|string","field_type":"text"},
    {"name":"Repository Branch","description":"Branch to deploy","env_variable":"REPO_BRANCH","default_value":"main","user_viewable":true,"user_editable":true,"rules":"required|string","field_type":"text"},
    {"name":"Node Major","description":"Node.js major version","env_variable":"NODE_MAJOR","default_value":"22","user_viewable":true,"user_editable":true,"rules":"required|integer|between:18,23","field_type":"text"},
    {"name":"Server Port","description":"Backend websocket/feed port","env_variable":"SERVER_PORT","default_value":"8787","user_viewable":true,"user_editable":true,"rules":"required|integer|between:1,65535","field_type":"text"},
    {"name":"Web Port","description":"Optional frontend preview port","env_variable":"WEB_PORT","default_value":"4173","user_viewable":true,"user_editable":true,"rules":"required|integer|between:1,65535","field_type":"text"},
    {"name":"Run Frontend","description":"1 = run Vite preview alongside feed, 0 = feed only","env_variable":"RUN_FRONTEND","default_value":"1","user_viewable":true,"user_editable":true,"rules":"required|in:0,1","field_type":"text"},
    {"name":"Google Maps API Key","description":"Used by frontend for Photorealistic 3D Tiles","env_variable":"GOOGLE_MAPS_API_KEY","default_value":"","user_viewable":true,"user_editable":true,"rules":"nullable|string","field_type":"text"},
    {"name":"OpenSky Poll ms","description":"OpenSky poll interval","env_variable":"OPEN_SKY_POLL_MS","default_value":"8000","user_viewable":true,"user_editable":true,"rules":"required|integer|min:1000","field_type":"text"},
    {"name":"CelesTrak Refresh ms","description":"TLE refresh interval","env_variable":"CELESTRAK_REFRESH_MS","default_value":"300000","user_viewable":true,"user_editable":true,"rules":"required|integer|min:10000","field_type":"text"}
  ]
