# Optional configuration. Panel environment variables take priority.
# Do not commit this file after copying to .env.production.
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=3000
# Set to your HTTPS origin after configuring the reverse proxy.
PUBLIC_ORIGIN=
# Trust only your actual proxy address/subnet. Never set to true or 0.0.0.0/0.
TRUST_PROXY=loopback
# Generated and persisted in data/.session-key when empty.
JWT_SECRET=
DATA_CACHE_PATH=./data/last-known-good.json
CLIENT_LOGGING=false
# Browser-visible credentials: restrict origins and permissions at the provider.
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=
# Server-only credentials. Optional providers remain unavailable until configured.
ABUSEIPDB_API_KEY=
ADSB_EXCHANGE_API_KEY=
AISSTREAM_API_KEY=
AZ511_API_KEY=
DOWNDETECTOR_API_TOKEN=
GA511_API_KEY=
HIBP_API_KEY=
HUNTER_API_KEY=
LA511_API_KEY=
N2YO_API_KEY=
NY511_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_PASSWORD=
OPENSKY_USERNAME=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
WI511_API_KEY=

# Free feeds; see src/config.js for every supported option and default.
ENABLE_OPENSKY=true
OPENSKY_AUTH_MODE=none
ENABLE_ADSB=true
ENABLE_ADSB_LOL=true
ENABLE_SATELLITES=true
SATELLITE_PROVIDER=celestrak_sgp4
ENABLE_SEISMIC=true
ENABLE_TRAFFIC=true
ENABLE_CCTV=true
ENABLE_INTEL=true
ENABLE_DOWNDETECTOR=false
MARITIME_PROVIDER=aisstream
